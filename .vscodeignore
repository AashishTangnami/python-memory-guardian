# The client and its npm runtime dependencies are bundled in dist/extension.js.
node_modules/**
out/**
# src/python/** ships: the language server, profiler, probe and bundled packages.
src/typescript/**
src/rust/**
scripts/**
tests/**
examples/**
requirements-dev.txt
requirements-acceptance.txt
requirements-quality.txt
eslint.config.mjs
pyproject.toml
tsconfig.json
package-lock.json

# Keep src/python/libs (including licenses) and an optional bin/guardian-server.
# Exclude development caches, interpreter-specific bytecode, and build artifacts.
.*
.*/**
**/__pycache__/**
**/*.pyc
**/*.pyo
**/*.map
**/.DS_Store
**/.pmg/**
*.vsix
*.zip
