{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/AashishTangnami/python-memory-guardian/docs/pmg-summary.schema.json",
  "title": "Python Memory Guardian profile summary (pmg-summary/1)",
  "description": "Written to .pmg/summary.json after each profiling run. Every value comes from the profile in profile.path; each section states its measurement method and limits. Paths are relative to the project folder when inside it.",
  "type": "object",
  "additionalProperties": false,
  "required": ["format", "generated_at", "generator", "profile", "run", "methods", "totals", "functions", "lines",
    "memory_stacks", "memory_observations", "capabilities", "gc", "diagnostics", "phases", "retention", "largest_objects", "static_diagnostics", "source", "comparison", "next_steps"],
  "properties": {
    "format": { "const": "pmg-summary/1" },
    "generated_at": { "type": "string" },
    "generator": { "type": "string" },
    "profile": {
      "type": "object", "required": ["path", "schema"],
      "properties": { "path": { "type": "string" }, "schema": { "type": "integer" } }
    },
    "run": {
      "type": "object",
      "required": ["script", "python", "platform", "argv", "started_at", "memory_mode", "interval_s", "samples", "traceback_frames", "gil_split", "incomplete", "traced_function"],
      "properties": {
        "script": { "type": "string" },
        "python": { "type": "string" },
        "platform": { "type": ["string", "null"] },
        "argv": { "type": ["array", "null"], "items": { "type": "string" } },
        "started_at": { "type": ["string", "null"] },
        "memory_mode": { "enum": ["fast", "precise", "off"] },
        "interval_s": { "type": ["number", "null"] },
        "samples": { "type": ["integer", "null"] },
        "traceback_frames": { "type": ["integer", "null"] },
        "gil_split": { "type": "boolean" },
        "incomplete": { "type": "array", "items": { "type": "string" }, "description": "Conditions that make part of the evidence incomplete (tracing stopped, sampler failed)." },
        "traced_function": {
          "type": ["object", "null"], "description": "Precise mode traced only while this function ran (--trace-function).",
          "required": ["name", "calls", "traced_s"],
          "properties": { "name": { "type": "string" }, "calls": { "type": "integer" }, "traced_s": { "type": "number" } }
        },
        "command": {"type": ["array", "null"], "items": {"type": "string"}},
        "cwd": {"type": ["string", "null"]},
        "process_id": {"type": ["integer", "null"]},
        "memory_snapshot_at_exit": {"type": ["boolean", "null"]}
      }
    },
    "methods": {
      "type": "object", "required": ["time", "memory"],
      "properties": {
        "time": { "$ref": "#/$defs/method" },
        "memory": {
          "type": ["object", "null"],
          "properties": { "traced": { "$ref": "#/$defs/method" }, "process": { "$ref": "#/$defs/method" }, "native_estimate": { "$ref": "#/$defs/method" } }
        }
      }
    },
    "totals": {
      "type": "object",
      "description": "Run-level values. Unavailable observations are null; they never become measured zero.",
      "additionalProperties": { "$ref": "#/$defs/measuredNullable" },
      "properties": {
        "run_duration_s": { "$ref": "#/$defs/measuredNullable" }, "process_cpu_s": { "$ref": "#/$defs/measuredNullable" },
        "peak_traced_mb": { "$ref": "#/$defs/measuredNullable" }, "held_at_exit_mb": { "$ref": "#/$defs/measuredNullable" },
        "native_estimate_mb": { "$ref": "#/$defs/measuredNullable", "description": "Legacy field name. Positive process RSS residual, uncertain; not measured native allocations." }, "rss_peak_mb": { "$ref": "#/$defs/measuredNullable" },
        "unattributed_peak_mb": { "$ref": "#/$defs/measuredNullable" }, "tracemalloc_peak_mb": { "$ref": "#/$defs/measuredNullable" },
        "held_at_last_snapshot_mb": {"$ref": "#/$defs/measuredNullable"}
      }
    },
    "functions": {
      "type": "array", "description": "Your functions: the top 20 by sampled time and the top 20 by memory, ordered by time.",
      "items": {
        "type": "object",
        "required": ["name", "file", "line", "end_line", "samples", "time_s", "share", "python_s", "native_s", "system_s"],
        "properties": {
          "name": { "type": "string" }, "file": { "type": "string" }, "line": { "type": "integer" },
          "end_line": { "type": ["integer", "null"] }, "samples": { "type": "integer", "minimum": 0 },
          "time_s": { "type": "number" }, "share": { "type": "number" },
          "python_s": { "type": "number" }, "native_s": { "type": "number" }, "system_s": { "type": "number" },
          "allocated_mb": { "type": "null" }, "held_at_peak_mb": { "type": ["number", "null"] }, "spike_mb": { "type": "null" },
          "native_estimate_mb": { "type": "null" }, "rss_growth_mb": { "type": "null" }
        }
      }
    },
    "lines": {
      "type": "array", "description": "Lines of your code: the top 20 by sampled time and the top 20 by memory, ordered by time.",
      "items": {
        "type": "object", "required": ["file", "line", "scope", "samples", "time_s", "share"],
        "properties": {
          "file": { "type": "string" }, "line": { "type": "integer" }, "scope": { "type": ["string", "null"] },
          "samples": { "type": "integer", "minimum": 0 }, "time_s": { "type": "number" }, "share": { "type": "number" },
          "allocated_mb": { "type": "null" }, "held_at_peak_mb": { "type": ["number", "null"] }, "spike_mb": { "type": "null" },
          "native_estimate_mb": { "type": "null" }, "rss_growth_mb": { "type": "null" },
          "suspected_leak": { "const": true }, "held_at_exit_mb": { "type": ["number", "null"] }, "line_events": { "type": "integer" }
        }
      }
    },
    "memory_stacks": {
      "type": ["object", "null"], "description": "Precise mode only.",
      "required": ["method", "limits", "peak", "exit", "last_snapshot", "snapshot_at_exit"],
      "properties": {
        "method": { "type": "string" }, "limits": { "$ref": "#/$defs/limits" },
        "peak": { "anyOf": [{ "$ref": "#/$defs/stackTable" }, { "type": "null" }] },
        "exit": {"anyOf": [{"$ref": "#/$defs/stackTable"}, {"type": "null"}]},
        "last_snapshot": {"$ref": "#/$defs/stackTable"},
        "snapshot_at_exit": {"type": "boolean"}
      }
    },
    "phases": {
      "type": ["object", "null"], "description": "What the main thread was doing over time; null when the profile has no timeline stacks.",
      "required": ["depth", "method", "limits", "phases"],
      "properties": {
        "depth": { "type": "integer" }, "method": { "type": "string" }, "limits": { "$ref": "#/$defs/limits" },
        "phases": {
          "type": "array",
          "items": {
            "type": "object", "required": ["function", "file", "line", "from_s", "to_s", "peak_traced_mb", "peak_rss_mb", "new_rss_mb"],
            "properties": {
              "function": { "type": "string" }, "file": { "type": "string" }, "line": { "type": "integer" },
              "from_s": { "type": "number" }, "to_s": { "type": "number" }, "peak_traced_mb": { "type": ["number", "null"] },
              "peak_rss_mb": { "type": ["number", "null"] }, "new_rss_mb": { "type": ["number", "null"] }
            }
          }
        }
      }
    },
    "retention": {
      "type": ["object", "null"], "description": "Precise mode only.",
      "required": ["method", "limits", "findings"],
      "properties": {
        "method": { "type": "string" }, "limits": { "$ref": "#/$defs/limits" },
        "findings": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["file", "line", "scope", "status", "held_at_exit_mb", "largest_snapshot_mb", "evidence", "holders", "recommendations"],
            "properties": {
              "file": { "type": "string" }, "line": { "type": "integer" }, "scope": { "type": "string" },
              "status": { "enum": ["growing", "retained", "released"] },
              "held_at_exit_mb": { "type": ["number", "null"] }, "largest_snapshot_mb": { "type": "number" },
              "evidence": { "$ref": "#/$defs/strings" }, "holders": { "$ref": "#/$defs/strings" }, "recommendations": { "$ref": "#/$defs/strings" },
              "held_at_last_snapshot_mb": {"type": "number"},
              "snapshot_at_exit": {"type": "boolean"},
              "category": {"const": "retention"},
              "severity": {"enum": ["warning", "information"]},
              "confidence": {"enum": ["medium", "high"]},
              "evidence_status": {"const": "measured"},
              "source": {"type": "object"},
              "workload": {"type": "object"},
              "reproduction": {"type": "object"}
            }
          }
        }
      }
    },
    "largest_objects": {
      "type": ["object", "null"],
      "required": ["method", "limits", "objects"],
      "properties": {
        "method": { "type": "string" }, "limits": { "$ref": "#/$defs/limits" },
        "objects": {
          "type": "array",
          "items": {
            "type": "object", "required": ["holder", "type", "mb", "items", "estimated"],
            "properties": { "holder": { "type": "string" }, "type": { "type": "string" }, "mb": { "type": "number" },
              "items": { "type": ["integer", "null"] }, "estimated": { "type": "boolean" } }
          }
        }
      }
    },
    "static_diagnostics": {
      "type": "object", "required": ["method", "limits", "findings"],
      "properties": {
        "method": { "type": "string" }, "limits": { "$ref": "#/$defs/limits" },
        "findings": {
          "type": "array",
          "items": {
            "type": "object", "required": ["file", "line", "code", "severity", "message", "measured"],
            "properties": {
              "file": { "type": "string" }, "line": { "type": "integer" }, "code": { "type": "string" },
              "severity": { "enum": ["error", "warning", "information", "hint"] }, "message": { "type": "string" },
              "measured": { "enum": ["hot", "cold", "unknown", "source changed"] }
            }
          }
        }
      }
    },
    "source": {
      "type": "object", "required": ["method", "files"],
      "properties": {
        "method": { "type": "string" },
        "files": {
          "type": "array",
          "items": {
            "type": "object", "required": ["file", "sha1", "freshness"],
            "properties": { "file": { "type": "string" }, "sha1": { "type": ["string", "null"] },
              "freshness": { "enum": ["fresh", "stale", "unverified"] } }
          }
        }
      }
    },
    "comparison": {
      "type": ["object", "null"], "description": "Present when a baseline is selected in the report's Compare tab.",
      "required": ["baseline", "baseline_meta", "warnings", "notes", "method", "run", "functions"],
      "properties": {
        "baseline": { "type": "string" },
        "baseline_meta": { "type": ["object", "null"] },
        "warnings": { "$ref": "#/$defs/strings" }, "notes": { "$ref": "#/$defs/strings" }, "method": { "type": "string" },
        "run": { "type": "array", "items": { "allOf": [{ "$ref": "#/$defs/delta" }, { "type": "object", "required": ["measure", "unit"],
          "properties": { "measure": { "type": "string" }, "unit": { "enum": ["s", "MB"] } } }] } },
        "functions": {
          "type": "array",
          "items": {
            "type": "object", "required": ["name", "file", "line", "baseline_line", "time_s", "leak"],
            "properties": {
              "name": { "type": "string" }, "file": { "type": "string" },
              "line": { "type": ["integer", "null"] }, "baseline_line": { "type": ["integer", "null"] },
              "time_s": { "$ref": "#/$defs/delta" }, "allocated_mb": { "$ref": "#/$defs/delta" }, "held_at_peak_mb": { "$ref": "#/$defs/delta" },
              "held_at_exit_mb": { "$ref": "#/$defs/delta" }, "native_estimate_mb": { "$ref": "#/$defs/delta" }, "rss_growth_mb": { "$ref": "#/$defs/delta" },
              "leak": { "enum": ["new", "gone", "both", null] }
            }
          }
        }
      }
    },
    "next_steps": { "$ref": "#/$defs/strings" },
    "memory_observations": {
      "type": ["array", "null"],
      "description": "Bounded process observations. They have no allocating source or thread identity.",
      "items": {
        "type": "object",
        "required": ["t", "traced_bytes", "traced_growth_bytes", "transient_bytes", "rss_bytes", "rss_change_bytes", "bookkeeping_bytes"],
        "properties": {
          "t": {"type": "number"},
          "traced_bytes": {"type": ["number", "null"]},
          "traced_growth_bytes": {"type": ["number", "null"]},
          "transient_bytes": {"type": ["number", "null"]},
          "rss_bytes": {"type": ["number", "null"]},
          "rss_change_bytes": {"type": ["number", "null"]},
          "bookkeeping_bytes": {"type": ["number", "null"]}
        }
      }
    },
    "capabilities": {"type": "object", "additionalProperties": {"$ref": "#/$defs/capability"}},
    "gc": {
      "type": ["object", "null"],
      "required": ["method", "limits", "supported", "events", "dropped_events", "total_collections", "total_pause_s", "collected", "uncollectable"],
      "properties": {
        "method": {"type": "string"},
        "limits": {"$ref": "#/$defs/limits"},
        "supported": {"const": true},
        "events": {"type": "array", "items": {"type": "object"}},
        "dropped_events": {"type": "integer"},
        "total_collections": {"type": "integer"},
        "total_pause_s": {"type": "number"},
        "collected": {"type": "integer"},
        "uncollectable": {"type": "integer"}
      }
    },
    "diagnostics": {
      "type": ["object", "null"],
      "description": "Cooperative diagnostic event trace and findings. The profile parser validates its event and finding contract.",
      "required": ["schema", "instrumentation", "trace_path", "events", "findings", "dropped_events", "scan_limits", "capabilities"],
      "properties": {
        "schema": {"const": 1},
        "instrumentation": {"const": "cooperative"},
        "trace_path": {"type": ["string", "null"]},
        "events": {"type": "array", "items": {"type": "object"}},
        "findings": {"type": "array", "items": {"type": "object"}},
        "dropped_events": {"type": "integer"},
        "scan_limits": {"type": "object"},
        "capabilities": {"type": "object", "additionalProperties": {"$ref": "#/$defs/capability"}}
      }
    },
    "memory_guard": {
      "type": ["object", "null"],
      "description": "External budget policy, observed RSS pressure and stop reason. Includes profiler memory. A guard stop is not an OOM/leak finding; polling may overshoot."
    },
    "allocation_backend": {
      "type": ["object", "null"],
      "description": "Validated allocator request capture, distinct from object counts, RSS and leak evidence."
    }
  },
  "$defs": {
    "strings": { "type": "array", "items": { "type": "string" } },
    "limits": { "type": "array", "items": { "type": "string" }, "description": "What this evidence cannot show. Always present; may be empty." },
    "method": {
      "type": "object", "required": ["method", "limits"],
      "properties": { "method": { "type": "string" }, "limits": { "$ref": "#/$defs/limits" } }
    },
    "measured": {
      "type": "object", "additionalProperties": false, "required": ["value", "unit", "method", "limits"],
      "properties": { "value": { "type": "number" }, "unit": { "enum": ["s", "MB", "count"] },
        "method": { "type": "string" }, "limits": { "$ref": "#/$defs/limits" } }
    },
    "delta": {
      "type": "object", "required": ["baseline", "current", "change", "variation", "verdict"],
      "properties": {
        "baseline": { "type": ["number", "null"] }, "current": { "type": ["number", "null"] },
        "change": { "type": "number" }, "variation": { "type": "number", "description": "Run-to-run variation; a change within it is \"same\"." },
        "verdict": { "enum": ["better", "worse", "same", "new", "gone", "context"] }
      }
    },
    "stackTable": {
      "type": "object", "required": ["t_s", "total_mb", "other_mb", "truncated", "by_function", "top_stacks"],
      "properties": {
        "t_s": { "type": "number" }, "total_mb": { "type": "number" }, "other_mb": { "type": "number" }, "truncated": { "type": "boolean" },
        "by_function": {
          "type": "array",
          "items": { "type": "object", "required": ["function", "file", "line", "mb"],
            "properties": { "function": { "type": "string" }, "file": { "type": "string" }, "line": { "type": "integer" }, "mb": { "type": "number" } } }
        },
        "top_stacks": {
          "type": "array",
          "items": { "type": "object", "required": ["mb", "truncated", "frames"],
            "properties": { "mb": { "type": "number" }, "truncated": { "type": "boolean" }, "frames": { "$ref": "#/$defs/strings" } } }
        }
      }
    },
    "measuredNullable": {"anyOf": [{"$ref": "#/$defs/measured"}, {"type": "null"}]},
    "capability": {
      "type": "object",
      "required": ["status", "reason"],
      "properties": {"status": {"enum": ["supported", "partial", "unavailable"]}, "reason": {"type": "string"}}
    }
  }
}
